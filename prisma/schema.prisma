generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Institution {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  createdAt DateTime @default(now())

  users         User[]
  students      Student[]
  classes       Class[]
  subjects      Subject[]
  tickets       Ticket[]
  announcements Announcement[]
  aiConfig      AIConfig?
}

model User {
  id            String   @id @default(uuid())
  institutionId String
  cognitoId     String   @unique
  email         String   @unique
  fullName      String
  role          String
  avatarUrl     String?
  phoneNumber   String?
  createdAt     DateTime @default(now())

  institution Institution @relation(fields: [institutionId], references: [id])

  @@index([institutionId, role])
}

model Student {
  id            String    @id @default(uuid())
  institutionId String
  fullName      String
  studentCode   String    @unique
  classId       String
  parentId      String
  dateOfBirth   DateTime?
  createdAt     DateTime  @default(now())

  institution Institution @relation(fields: [institutionId], references: [id])
  class       Class       @relation(fields: [classId], references: [id])
  tickets     Ticket[]
}

model Class {
  id             String  @id @default(uuid())
  institutionId  String
  name           String
  year           Int
  classTeacherId String?

  institution   Institution    @relation(fields: [institutionId], references: [id])
  students      Student[]
  tickets       Ticket[]
  announcements Announcement[]
  subjects      Subject[]
}

model Subject {
  id            String @id @default(uuid())
  institutionId String
  name          String
  classId       String
  teacherId     String

  institution Institution @relation(fields: [institutionId], references: [id])
  class       Class       @relation(fields: [classId], references: [id])
  tickets     Ticket[]
}

model Ticket {
  id                   String    @id @default(uuid())
  institutionId        String
  parentId             String
  studentId            String
  classId              String
  subjectId            String?
  title                String
  description          String
  status               String    @default("open")
  escalationLevel      String?
  assignedTeacherId    String?
  classTeacherId       String?
  principalId          String?
  deadlineAt           DateTime
  escalationDeadlineAt DateTime?
  chimeMeetingId       String?
  aiSummaryAt          DateTime?
  satisfaction         String?
  resolvedAt           DateTime?
  closedAt             DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  institution Institution     @relation(fields: [institutionId], references: [id])
  student     Student         @relation(fields: [studentId], references: [id])
  class       Class           @relation(fields: [classId], references: [id])
  subject     Subject?        @relation(fields: [subjectId], references: [id])
  messages    TicketMessage[]
  callLogs    CallLog[]

  @@index([institutionId, status])
  @@index([escalationDeadlineAt])
  @@index([parentId])
}

model TicketMessage {
  id          String    @id @default(uuid())
  ticketId    String
  senderId    String
  senderRole  String
  content     String?
  audioUrl    String?
  messageType String    @default("text")
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
}

model DirectMessage {
  id            String    @id @default(uuid())
  institutionId String
  threadId      String
  senderId      String
  senderRole    String
  content       String?
  audioUrl      String?
  messageType   String    @default("text")
  readAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([threadId])
  @@index([institutionId, senderId])
}

model Announcement {
  id            String   @id @default(uuid())
  institutionId String
  authorId      String
  title         String
  body          String
  audience      String
  classId       String?
  pinned        Boolean  @default(false)
  createdAt     DateTime @default(now())

  institution Institution @relation(fields: [institutionId], references: [id])
  class       Class?      @relation(fields: [classId], references: [id])

  @@index([institutionId, audience])
}

model Notification {
  id            String    @id @default(uuid())
  userId        String
  institutionId String
  type          String
  title         String
  body          String
  ticketId      String?
  read          Boolean   @default(false)
  emailSentAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId, read])
}

model CallLog {
  id              String    @id @default(uuid())
  institutionId   String
  ticketId        String?
  chimeMeetingId  String
  initiatedBy     String
  parentId        String
  startedAt       DateTime?
  endedAt         DateTime?
  durationSeconds Int?
  status          String

  ticket Ticket? @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
}

model AIConfig {
  institutionId String  @id
  provider      String
  model         String
  enabled       Boolean @default(false)

  institution Institution @relation(fields: [institutionId], references: [id])
}
