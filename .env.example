# AWS Core
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Cognito
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=

# Aurora Serverless
AURORA_CLUSTER_ARN=
AURORA_SECRET_ARN=
AURORA_DATABASE_NAME=lightapp
DATABASE_URL=

# S3 + CloudFront
S3_BUCKET_NAME=lightapp-prod
CLOUDFRONT_DOMAIN=
NEXT_PUBLIC_CLOUDFRONT_DOMAIN=

# SQS
SQS_QUEUE_URL=

# AppSync (real-time)
APPSYNC_API_URL=
APPSYNC_API_KEY=
NEXT_PUBLIC_APPSYNC_URL=
NEXT_PUBLIC_APPSYNC_API_KEY=

# SES
SES_FROM_ADDRESS=noreply@yourdomain.com
SES_FROM_NAME=Light App

# Chime SDK
CHIME_REGION=us-east-1

# Bedrock (AI)
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
